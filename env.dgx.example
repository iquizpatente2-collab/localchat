# Ollama on a remote GPU server (DGX / office LAN). Default Ollama port is 11434 (not 11435).
OLLAMA_HOST=http://192.168.0.99:11434

# Match models you pulled on the DGX (see: ollama list). Embedding model is required for RAG.
OLLAMA_CHAT_MODEL=qwen3.6:latest
OLLAMA_CHAT_FALLBACK=gemma4:latest
OLLAMA_EMBED_MODEL=nomic-embed-text

# RAG_DOCS_FILE=docs/my-manual.pdf
# RAG_AUTO_DOCS=0

# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin
