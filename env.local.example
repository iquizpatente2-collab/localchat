# Ollama on the SAME machine as Docker (Windows Docker Desktop or Linux + extra_hosts in compose).
OLLAMA_HOST=http://host.docker.internal:11434
# Linux: if 172.17.0.1 fails, use the IP from: ss -tlnp | grep 11434
# Example (DGX): OLLAMA_HOST=http://192.168.0.99:11434

# Match models you pulled with: ollama pull <name>
OLLAMA_CHAT_MODEL=qwen3.6:latest
OLLAMA_CHAT_FALLBACK=gemma4:latest
OLLAMA_EMBED_MODEL=nomic-embed-text

# DGX / busy Ollama: keep low; also set OLLAMA_NUM_PARALLEL=4 on the Ollama service.
RAG_EMBED_CONCURRENCY=2

# Optional: force one PDF in docs/ (otherwise newest .pdf is used).
# RAG_DOCS_FILE=docs/my-manual.pdf

# Auto-index docs/ PDF on container start (1=yes, 0=click "Use docs PDF" in UI).
# RAG_AUTO_DOCS=1

# Admin login for PDF ingest + community notes (change in production).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin
